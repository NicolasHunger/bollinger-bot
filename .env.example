# Vorlage für die Datei .env: kopieren (cp .env.example .env) und die Platzhalter ersetzen.
# Die .env enthält die Keys und wird nie committet (.env und .env.* stehen in der .gitignore).
# Format: NAME='wert', ohne Leerzeichen um das «=». Die einfachen Anführungszeichen sorgen dafür,
# dass `source .env` und Docker Compose Zeichen wie $ # & oder Leerzeichen gleich lesen.

# Demo-API-Key aus dem Demo-Bereich von Bitget, nie einen Key mit echtem Geld
BITGET_API_KEY='dein-demo-api-key'
# Secret, das Bitget beim Erstellen des Demo-API-Keys einmal anzeigt
BITGET_API_SECRET='dein-demo-api-secret'
# Passphrase, die du beim Erstellen des Demo-API-Keys selbst gewählt hast
BITGET_PASSPHRASE='deine-passphrase'

# SQLite-Datei für Signale, Trades und Kontostände (Ordner wird angelegt, data/ ist gitignored).
# Eine Datei gilt für genau ein Handelspaar und ein Intervall. Ein relativer Pfad gilt ab dem
# Ordner, in dem der Bot startet. In Docker einen absoluten Pfad im gemeinsamen Volume von Bot
# und Dashboard verwenden, z.B. /data/bot.db.
BOT_DB_PFAD=data/bot.db
# Kerzen-Intervall im Bitget-Format: 1min, 5min, 15min, 30min oder 1h
BOT_INTERVALL=15min
